<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.verimimari.outbox-recovery</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE_BIN}}</string>
    <string>{{WORKSPACE_ROOT}}/scripts/outbox_recovery_runner.cjs</string>
  </array>
  <key>WorkingDirectory</key><string>{{WORKSPACE_ROOT}}</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>{{WORKSPACE_ROOT}}/.runtime/outbox_recovery.stdout.log</string>
  <key>StandardErrorPath</key><string>{{WORKSPACE_ROOT}}/.runtime/outbox_recovery.stderr.log</string>
</dict>
</plist>
